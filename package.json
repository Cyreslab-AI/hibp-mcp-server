{
  "name": "hibp-mcp-server",
  "version": "0.1.0",
  "description": "A Model Context Protocol server for Have I Been Pwned API integration",
  "private": true,
  "type": "module",
  "bin": {
    "hibp-mcp-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
